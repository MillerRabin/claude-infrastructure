[Unit]
Description=Telegram front-end for Claude Code sessions
After=network-online.target wg-quick@wg-ns.service openconnect-fsk.service
Wants=network-online.target
ConditionPathExists=/home/claude/.config/claude-tg/token

[Service]
User=claude
Group=claude
Environment=HOME=/home/claude
WorkingDirectory=/home/claude
ExecStart=/usr/bin/python3 /home/claude/claude-tg-bot/bot.py /home/claude/.config/claude-tg/config.toml
Restart=always
RestartSec=10
# Claude runs here with full permissions on a production host: keep it away from everything else
NoNewPrivileges=yes
InaccessiblePaths=-/home/ci -/home/millerrabin -/root
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=3G
TasksMax=512
CPUQuota=200%

[Install]
WantedBy=multi-user.target
