[Unit]
Description=Claude Code tmux sessions (namesilo, personal)
After=network-online.target wg-quick@ns.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=millerrabin
Group=millerrabin
Environment=HOME=/home/millerrabin
WorkingDirectory=/home/millerrabin
ExecStart=/home/millerrabin/.local/bin/claude-tmux-start
ExecStop=/usr/bin/tmux kill-server

[Install]
WantedBy=multi-user.target
