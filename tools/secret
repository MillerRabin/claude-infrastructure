#!/usr/bin/env python3
"""secret - small front-end to the Bitwarden/Vaultwarden collection used as Claude's secret store.

  secret list                       names of the items in the collection
  secret get NAME [--field F]       print the password (default), username or notes of an item
  secret set NAME                   create/update an item; the value is read from stdin (never from argv)
  secret run NAME[=ENV] ... -- CMD  run CMD with the listed secrets in its environment
  secret env NAME ...               print `export NAME='value'` lines (for `eval "$(secret env A B)"`)
  secret sync                       refresh the local cache from the server (done automatically when a name is not found)
  secret lock                       forget the cached session

Every access is appended to ~/.local/state/secret/access.log (time, action, item name; never the value).
Config: ~/.config/secret/config.json {"server": "...", "collection": "AI"}; the master password of the bw account
is read from ~/.config/secret/master (mode 600) to unlock bw without a prompt.
"""
import base64, json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
CONF = json.load(open(f"{HOME}/.config/secret/config.json"))
MASTER = f"{HOME}/.config/secret/master"
RUNTIME = f"{HOME}/.cache"   # /run/user vanishes when the last ssh session ends
SESSION_FILE = f"{RUNTIME}/secret-session"
LOG = f"{HOME}/.local/state/secret/access.log"


def die(msg, code=1):
    print(f"secret: {msg}", file=sys.stderr)
    sys.exit(code)


def bw(*args, session=None, input=None):
    env = dict(os.environ, BW_NOINTERACTION="true")
    if session:
        env["BW_SESSION"] = session
    p = subprocess.run(["bw", *args, "--nointeraction"], env=env, input=input, capture_output=True, text=True)
    return p.returncode, p.stdout.strip(), p.stderr


def audit(action, name):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {action} {name} ppid={os.getppid()}\n")
    os.chmod(LOG, 0o600)


def unlock():
    if not os.path.exists(MASTER):
        die(f"no master password file {MASTER}")
    rc, out, err = bw("unlock", "--passwordfile", MASTER, "--raw")
    if rc != 0 or not out:
        die("cannot unlock bw (wrong master password or not logged in: `bw login`)")
    os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
    fd = os.open(SESSION_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(out)
    bw("sync", session=out)
    return out


def session():
    # no validity check here (it costs a bw start): a failed call re-unlocks in items()
    if os.path.exists(SESSION_FILE):
        s = open(SESSION_FILE).read().strip()
        if s:
            return s
    return unlock()


COLL_FILE = f"{RUNTIME}/secret-collection"


def collection(s):
    rc, out, _ = bw("list", "collections", session=s)
    if rc != 0:
        return None
    cols = [c for c in json.loads(out or "[]") if c["name"] == CONF["collection"]]
    if not cols:
        die(f"collection {CONF['collection']!r} is not visible to this account (not confirmed yet?)")
    return cols[0]


def items(s, refresh=False):
    """returns (collection, items); the collection id is cached, a failed call re-unlocks once"""
    if refresh:
        bw("sync", session=s)
    for attempt in (0, 1):
        c = None
        if os.path.exists(COLL_FILE):
            c = json.load(open(COLL_FILE))
        rc, out, _ = bw("list", "items", "--collectionid", c["id"], session=s) if c else (1, "", "")
        if rc == 0:
            return c, json.loads(out or "[]")
        if attempt == 0:
            s = unlock()
            c = collection(s)
            if c:
                fd = os.open(COLL_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as f:
                    json.dump(c, f)
    die("cannot read the collection")


def find(s, name):
    for refresh in (False, True):       # a miss may just mean the local cache is stale: sync once and retry
        c, its = items(s, refresh)
        for i in its:
            if i["name"] == name:
                return c, i
    return c, None


def value(item, field="password"):
    if field == "notes":
        return item.get("notes") or ""
    return (item.get("login") or {}).get(field) or ""


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "lock":
        for f_ in (SESSION_FILE, COLL_FILE):
            try: os.remove(f_)
            except FileNotFoundError: pass
        bw("lock"); return 0
    s = session()
    if cmd == "sync":
        rc, _, err = bw("sync", session=s)
        if rc != 0: die("sync failed")
        print("synced"); return 0
    if cmd == "list":
        _, its = items(s, True)     # list is rare and should be exact
        audit("list", "*")
        print("\n".join(sorted(i["name"] for i in its))); return 0
    if cmd == "get":
        field = "password"
        if "--field" in rest:
            k = rest.index("--field"); field = rest[k + 1]; del rest[k:k + 2]
        if len(rest) != 1: die("usage: secret get NAME [--field password|username|notes]")
        _, it = find(s, rest[0])
        if not it: die(f"no such secret: {rest[0]}", 2)
        audit("get", rest[0]); sys.stdout.write(value(it, field)); return 0
    if cmd in ("env", "run"):
        names = rest
        command = None
        if cmd == "run":
            if "--" not in rest: die("usage: secret run NAME[=ENVVAR] ... -- COMMAND")
            k = rest.index("--"); names, command = rest[:k], rest[k + 1:]
            if not command: die("no command after --")
        _, its = items(s)
        byname = {i["name"]: i for i in its}
        if any(n.partition("=")[0] not in byname for n in names):
            _, its = items(s, True)
            byname = {i["name"]: i for i in its}
        env = {}
        for n in names:
            name, _, var = n.partition("=")
            if name not in byname: die(f"no such secret: {name}", 2)
            env[var or name] = value(byname[name]); audit(cmd, name)
        if cmd == "env":
            for k_, v in env.items():
                print(f"export {k_}='{v.replace(chr(39), chr(39) + chr(92) + chr(39) + chr(39))}'")
            return 0
        os.execvpe(command[0], command, dict(os.environ, **env))
    if cmd == "set":
        if len(rest) != 1: die("usage: secret set NAME   (value on stdin)")
        val = sys.stdin.read().rstrip("\n")
        if not val: die("empty value")
        c, it = find(s, rest[0])
        if it:
            it.setdefault("login", {})["password"] = val
            payload = base64.b64encode(json.dumps(it).encode()).decode()
            rc, _, err = bw("edit", "item", it["id"], payload, session=s)
        else:
            body = {"organizationId": c["organizationId"], "collectionIds": [c["id"]], "type": 1,
                    "name": rest[0], "notes": None, "favorite": False,
                    "login": {"username": None, "password": val, "uris": []}}
            payload = base64.b64encode(json.dumps(body).encode()).decode()
            rc, _, err = bw("create", "item", payload, session=s)
        if rc != 0: die(f"bw failed: {err.strip().splitlines()[-1] if err.strip() else rc}")
        audit("set", rest[0]); return 0
    die(f"unknown command {cmd}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
